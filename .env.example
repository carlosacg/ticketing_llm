# Which LLM backs /tickets/analyze: "anthropic" or "openai"
LLM_PROVIDER=anthropic
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Used when running outside docker compose (compose overrides it to point at the db service)
DATABASE_URL=postgresql+asyncpg://ticketing:ticketing@localhost:5432/ticketing
